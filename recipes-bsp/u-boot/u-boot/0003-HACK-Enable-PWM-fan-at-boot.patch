From 08672ad5bf1c0e23c71046be58fe457d44a5e904 Mon Sep 17 00:00:00 2001
From: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
Date: Fri, 28 Mar 2025 13:55:36 +0900
Subject: [PATCH 3/3] HACK: Enable PWM fan at boot

Signed-off-by: Yuya Hamamachi <yuya.hamamachi.sx@renesas.com>
---
 board/renesas/sparrowhawk/Makefile                |  1 +
 board/renesas/sparrowhawk/sparrowhawk_late_init.c | 15 +++++++++++++++
 configs/r8a779g3_sparrowhawk_defconfig            |  1 +
 3 files changed, 17 insertions(+)
 create mode 100644 board/renesas/sparrowhawk/sparrowhawk_late_init.c

diff --git a/board/renesas/sparrowhawk/Makefile b/board/renesas/sparrowhawk/Makefile
index 4c9e2068353..cfe654d6565 100644
--- a/board/renesas/sparrowhawk/Makefile
+++ b/board/renesas/sparrowhawk/Makefile
@@ -9,3 +9,4 @@
 ifdef CONFIG_XPL_BUILD
 obj-y	+= sparrowhawk.o
 endif
+obj-y	+= sparrowhawk_late_init.o
diff --git a/board/renesas/sparrowhawk/sparrowhawk_late_init.c b/board/renesas/sparrowhawk/sparrowhawk_late_init.c
new file mode 100644
index 00000000000..100decc3d24
--- /dev/null
+++ b/board/renesas/sparrowhawk/sparrowhawk_late_init.c
@@ -0,0 +1,15 @@
+#include <compiler.h>
+
+int board_late_init(void)
+{
+    uint32_t *addr;
+
+    // Enable active fan
+    addr = 0xe6050984;
+    *addr = 0x8000;
+    addr = 0xe6050988;
+    *addr = 0x8000;
+
+    return 0;
+}
+
diff --git a/configs/r8a779g3_sparrowhawk_defconfig b/configs/r8a779g3_sparrowhawk_defconfig
index c2198bcfde9..1e1e52e663e 100644
--- a/configs/r8a779g3_sparrowhawk_defconfig
+++ b/configs/r8a779g3_sparrowhawk_defconfig
@@ -63,3 +63,4 @@ CONFIG_SF_DEFAULT_SPEED=40000000
 # CONFIG_SPL_EFI_PARTITION is not set
 # CONFIG_SPL_PARTITION_UUIDS is not set
 # CONFIG_SPL_DM_MMC is not set
+CONFIG_BOARD_LATE_INIT=y
-- 
2.34.1

